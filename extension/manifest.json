{
  "manifest_version": 3,
  "name": "X Bot Reply Filter",
  "version": "1.2.0",
  "description": "Uses OpenAI to detect bot/spam replies on X and hides them.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.openai.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html",
  "action": { "default_popup": "options.html", "default_title": "X Bot Reply Filter" }
}
